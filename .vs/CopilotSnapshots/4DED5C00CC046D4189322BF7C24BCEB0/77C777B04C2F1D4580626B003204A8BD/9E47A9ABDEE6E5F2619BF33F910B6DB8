using System;
using System.IO;
using System.Text.Json;
using System.Threading.Tasks;

namespace Lootlens;

public sealed class Settings {
    private static readonly JsonSerializerOptions JsonOptions = new() {
        WriteIndented = true
    };

    public bool InventoryValueEnabled { get; set; }
    public bool ShowFleaPrice { get; set; } = true;
    public bool ShowTraderPrice { get; set; } = true;
    public bool ShowProfit { get; set; }
    public int InventoryRegionWidth { get; set; } = 300;
    public int InventoryRegionHeight { get; set; } = 200;

    public Settings Clone() => new() {
        InventoryValueEnabled = InventoryValueEnabled,
        ShowFleaPrice = ShowFleaPrice,
        ShowTraderPrice = ShowTraderPrice,
        ShowProfit = ShowProfit,
        InventoryRegionWidth = InventoryRegionWidth,
        InventoryRegionHeight = InventoryRegionHeight
    };

    public void Normalize() {
        InventoryRegionWidth = Math.Clamp(InventoryRegionWidth, 100, 1200);
        InventoryRegionHeight = Math.Clamp(InventoryRegionHeight, 80, 1000);
    }

    public static async Task<Settings> LoadAsync() {
        try {
            if (!File.Exists(FilePath))
                return new Settings();

            await using var stream = File.OpenRead(FilePath);
            var loaded = await JsonSerializer.DeserializeAsync<Settings>(stream, JsonOptions);

            var result = loaded ?? new Settings();
            result.Normalize();
            return result;
        } catch {
            return new Settings();
        }
    }

    public static async Task SaveAsync(Settings settings) {
        settings.Normalize();

        Directory.CreateDirectory(AppDirectory);
        await using var stream = File.Create(FilePath);
        await JsonSerializer.SerializeAsync(stream, settings, JsonOptions);
    }

    private static string AppDirectory => Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData),
        "LootLens");

    private static string FilePath => Path.Combine(AppDirectory, "settings.json");
}
