<Window x:Class="Lootlens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LootLens"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="220" Height="80"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Opacity="0.98">

    <Border Background="#CC0F1620" CornerRadius="8" Padding="8,6"
            BorderBrush="Transparent" BorderThickness="0">
        <StackPanel>
            <!-- Top-linje: titel til venstre, X til højre -->
            <!-- Top-linje: titel til venstre, X til højre – træk her for at flytte -->
            <Grid Margin="0,0,0,10" Background="Transparent"
      MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown" Cursor="SizeAll">
                <TextBlock Text="◉ LootLens" FontSize="12" Foreground="#7a7aff"
               FontWeight="SemiBold" VerticalAlignment="Center"/>

                <Button x:Name="HelpButton"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,34,0" Width="16" Height="16" Padding="0"
                        Background="#22343A52" Foreground="#AAB3FF"
                        BorderBrush="#557a7aff" BorderThickness="1"
                        FontSize="11" FontWeight="Bold" Cursor="Hand"
                        Content="?" Click="HelpButton_Click"
                        ToolTip="F6 = vis/skjul&#x0a;Skriv = live-søg&#x0a;Enter = søg nu&#x0a;Esc = skjul&#x0a;✕ = luk&#x0a;&#x0a;Data: json.tarkov.dev (regular/items.json)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="CloseButton" Content="✕" 
            HorizontalAlignment="Right" VerticalAlignment="Center"
            Width="24" Height="24" Padding="0"
            Background="Transparent" Foreground="#666670"
            BorderThickness="0" FontSize="14" FontWeight="Bold"
            Cursor="Hand" Click="CloseButton_Click"
            ToolTip="Luk LootLens">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#CC3333"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ApiStatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#FFC58A"
                           FontSize="12"
                           Text="API: ukendt"/>

                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Content="⚙ Settings"
                        Background="#22343A52"
                        Foreground="#AAB3FF"
                        BorderBrush="#557a7aff"
                        BorderThickness="1"
                        Padding="8,4"
                        Cursor="Hand"
                        Click="SettingsButton_Click"/>
            </Grid>

            <TextBox x:Name="SearchBox" FontSize="16" Padding="8,6"
                     Background="#222228" Foreground="White" CaretBrush="White"
                     BorderBrush="#3a3a44" KeyDown="SearchBox_KeyDown"
                     TextChanged="SearchBox_TextChanged"/>

            <TextBlock x:Name="ResultText" Foreground="#F2F5FF" FontSize="11"
                       FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"
                       LineHeight="14"/>
        </StackPanel>
    </Border>
</Window>