<Window x:Class="LootLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LootLens"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="440" Height="340"
        WindowStartupLocation="CenterScreen">

    <Border Background="#E6141419" CornerRadius="12" Padding="16"
            BorderBrush="#337a7aff" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="◉ Lootlens" FontSize="12" Foreground="#7a7aff"
                       FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="F6 = vis/skjul · Enter = søg · Esc = skjul"
                       FontSize="11" Foreground="#666670"/>

            <TextBox x:Name="SearchBox" FontSize="16" Padding="8,6"
                     Background="#222228" Foreground="White" CaretBrush="White"
                     BorderBrush="#3a3a44" KeyDown="SearchBox_KeyDown"/>

            <TextBlock x:Name="ResultText" Foreground="White" FontSize="14"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>